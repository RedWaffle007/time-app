app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase client config — kept OUT of version control by choice.
# Not secret in the security sense (access is gated by Firestore rules + SHA-1),
# but excluded so projectId/appId/API-key material isn't published.
# Regenerate a working copy with `flutterfire configure`.
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
**/firebase_app_id_file.json

# Environment files
.env
*.env
.env.*

# Node deps for the Firestore rules tests (firestore-tests/).
# package-lock.json is deliberately NOT ignored — it pins the emulator harness.
node_modules/

# Firestore emulator output (already untracked at the repo root; the rules
# tests produce their own copy in firestore-tests/).
firestore-debug.log
