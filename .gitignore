app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase client config — kept OUT of version control by choice.
# Not secret in the security sense (access is gated by Firestore rules + SHA-1),
# but excluded so projectId/appId/API-key material isn't published.
# Regenerate a working copy with `flutterfire configure`.
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
**/firebase_app_id_file.json

# Environment files
.env
*.env
.env.*

# Service-account key files at the REPO ROOT. `worker/.gitignore` already covers
# these inside worker/, but the backfill script is documented as being run from
# the root — `node scripts/backfill-join-codes.mjs --key sa.json`
# (ARCHITECTURE.md, WORK_PLAN.md) — so the key lands HERE, where nothing was
# ignoring it. An admin key bypasses every Firestore rule; committing one is
# unrecoverable by rules changes and can only be fixed by revoking the key.
sa.json
*firebase-adminsdk*.json
*service-account*.json
service-account*.json

# Local scratch/analysis files (e.g. scratchpad/check.mjs). Untracked working
# notes, never part of the build.
scratchpad/

# Node deps for the Firestore rules tests (firestore-tests/).
# package-lock.json is deliberately NOT ignored — it pins the emulator harness.
node_modules/

# Firestore emulator output (already untracked at the repo root; the rules
# tests produce their own copy in firestore-tests/).
firestore-debug.log
