rules_version = '2';

// time-app Firestore security rules (v1).
//
// Model in one line: membership ≠ permission to plan. Everything
// relationship-sensitive (rosters, grants, schedules, group docs) is gated on
// group membership or on being the planner/target of the specific record.
// Consent to be planned for is the TARGET's to give.
//
// These rules are written to exactly match the app's real read/write paths
// (see lib/**/data/*_repository.dart).
//
// TWO RULES OF THUMB THIS FILE NOW ENFORCES EVERYWHERE — keep them:
//
//   1. `get` and `list` are DIFFERENT permissions, and `read` grants both. An
//      unconditional `allow read` on a collection authorises an unfiltered
//      LIST — i.e. dumping the whole collection — not just fetching one doc by
//      id. Enumeration was the actual hole here (ARCHITECTURE.md §4.1 a/b), so
//      every collection-level rule below spells the two out separately.
//
//   2. Write rules constrain the FIELD SET, not just the document. A rule that
//      says "the target may update their own item" also says "the target may
//      write ANY field on it" — including the `notified*` fields the push
//      Worker uses as its dedup guard, which let a target silently suppress the
//      notification that closes the accountability loop (§4.1 c). Every write
//      rule below whitelists keys.
//
// Anything the SERVER writes and no client may write (the `notified*` guards)
// is simply absent from every client whitelist: the Worker reaches Firestore
// with a service-account token, which bypasses these rules entirely.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----

    function signedIn() {
      return request.auth != null;
    }

    // Group-picture metadata for a byte-validated object returned by the Worker.
    // The Worker enforces the per-format byte cap; rules enforce the larger
    // animated ceiling and the exact document shape as a second boundary.
    function groupAvatarMetadataValid(avatar, groupId) {
      return avatar.keys().hasOnly([
          'url', 'storageKey', 'mime', 'sizeBytes', 'moderation', 'updatedAt'])
        && avatar.url is string
        && avatar.url.size() > 0
        && avatar.storageKey is string
        && avatar.storageKey.matches('^group-avatars/' + groupId + '/[^/]+$')
        && avatar.mime in ['image/jpeg', 'image/png', 'image/gif', 'image/webp']
        && avatar.sizeBytes is int
        && avatar.sizeBytes > 0
        && avatar.sizeBytes <= 5242880
        && avatar.moderation in ['approved', 'flagged', 'pending', 'rejected'];
    }

    // Is `uid` in the group's denormalized memberUids array?
    function uidInGroup(groupId, uid) {
      return exists(/databases/$(database)/documents/groups/$(groupId))
        && uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    // Is the CALLER a member of the group?
    function callerInGroup(groupId) {
      return signedIn() && uidInGroup(groupId, request.auth.uid);
    }

    // The group's owner uid. The owner (creator) is unremovable and always an
    // admin: `delete: if false` on /groups means a group that lost its owner
    // could never be cleaned up by anyone, ever.
    function groupOwnerUid(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid;
    }

    // WhatsApp-style admins (Batch G item 3, 2026-09-27; DECISIONS.md
    // "WhatsApp-style group admins"). The creator is always an admin; others
    // are listed in `adminUids`, which only the creator changes. A group
    // written before admins existed has no `adminUids` — its owner alone.
    function isAdminOf(groupData, uid) {
      return uid in groupData.memberUids
        && (uid == groupData.ownerUid || uid in groupData.get('adminUids', []));
    }

    function callerIsGroupAdmin(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && isAdminOf(get(/databases/$(database)/documents/groups/$(groupId)).data,
                     request.auth.uid);
    }

    // May the caller put a plan tagged with `groupId` on `targetUid`? Any member
    // may plan for the GROUP (item 3): both must be members of that group. No
    // grant, switch or hint row. (The app sends such plans only as a whole-
    // group fan-out; rules cannot see the other writes of that fan-out.)
    function callerMayGroupPlan(targetUid, groupId) {
      return groupId is string
        && groupId != ''
        && callerInGroup(groupId)
        && uidInGroup(groupId, targetUid);
    }

    // Keys whose value this write actually CHANGES (added, removed or altered).
    // A field rewritten with the value it already had does not appear — so an
    // idempotent re-approve is not mistaken for a status transition, while
    // `updatedAt` (a serverTimestamp) always does appear.
    // ---- social helpers (the friend graph) ----
    //
    // These exist because of one hard property of the rules engine: it can
    // `exists()` a path it can CONSTRUCT, and it cannot run a query. So every
    // social predicate below is answered by computing a document id from the
    // two uids in hand — which is exactly why `social_ids.dart` makes those ids
    // deterministic. A friendship under an auto-id, findable only by querying
    // `participants`, would be invisible here and the privacy toggle would be
    // unenforceable, i.e. a lie in the UI.

    // The sorted pair id of a friendship. Must match friendshipId() in
    // lib/features/social/domain/social_ids.dart EXACTLY — the two compute the
    // same address or nothing works.
    //
    // Named `sortedPairId`, not `pairId`, deliberately: the friendship match
    // below binds a wildcard called `pairId`, which would SHADOW a function of
    // that name inside the one block that needs it most.
    function sortedPairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // The uid in a two-element participants array that ISN'T the caller. Used
    // by the friendship-create rule to name the person whose request is being
    // accepted, without trusting the client to say who that is.
    function otherParty(participants) {
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }

    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(sortedPairId(a, b)));
    }

    // Is the CALLER a friend of `targetUid`? That is the whole planning
    // permission between two people (Batch G item 2, 2026-09-27, user-directed:
    // DECISIONS.md "Friendship is the planning permission"). There is no
    // separate grant, switch or request: friends may set alarms for each other
    // and read each other's schedule for the clash check. Unfriending or
    // blocking (which cascades the friendship away) ends it immediately. The
    // target's other ways out of one alarm are Done/Skip before it rings.
    function callerIsFriendOf(targetUid) {
      return areFriends(request.auth.uid, targetUid);
    }

    // Blocking is recorded one-way and ENFORCED BOTH WAYS. A one-directional
    // check would leave the blocked party able to read the blocker's profile,
    // which is the whole thing the feature is for. Two `exists()` calls, both
    // on computed ids.
    function blocked(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a + '_' + b))
        || exists(/databases/$(database)/documents/blocks/$(b + '_' + a));
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---- minute locks (Batch G item 4) ----
    // A person can hold ONE live plan per minute. The minute is the plan's
    // absolute instant in whole minutes since the epoch — so each person's own
    // timezone is already folded in, and DST's repeated hour is two minutes.
    function epochMinute(ts) {
      return string(int(math.floor(ts.toMillis() / 60000)));
    }

    function minuteLockPath(targetUid, ts) {
      return /databases/$(database)/documents/scheduleMinutes/$(targetUid)/minutes/$(epochMinute(ts));
    }

    // Is the plan at `path` still live — open, holding its minute?
    function planIsLive(path) {
      return exists(path)
        && get(path).data.get('outcome', null) == null
        && get(path).data.status in ['pending', 'approved'];
    }

    // ---- inactivityStates/{uid} ----
    // Private operational state for the six-hour re-engagement timer. The app
    // owns only the activity timestamp and derived due time; the privileged
    // Worker adds/updates the delivery cursor, lease, and last-delivered time.
    // Keeping this outside the broadly-gettable profile document prevents an
    // acquaintance who knows a uid from learning when that person used the app.
    match /inactivityStates/{uid} {
      function activityFieldsAreValid() {
        return request.resource.data.uid == uid
          && request.resource.data.lastActivityAt is timestamp
          && request.resource.data.nextNotificationAt is timestamp
          && request.resource.data.nextNotificationAt
             == request.resource.data.lastActivityAt + duration.value(6, 'h');
      }

      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'lastActivityAt', 'nextNotificationAt'])
        && activityFieldsAreValid();
      allow update: if signedIn()
        && request.auth.uid == uid
        && changedKeys().hasOnly(['lastActivityAt', 'nextNotificationAt'])
        && activityFieldsAreValid();
      allow delete: if false;
    }

    // ---- users/{uid} ----
    // Decision ①: a signed-in user may GET one profile by uid (name / avatar /
    // home tz) — the planner needs the target's name and home timezone, and the
    // target needs the planner's name. Writes are owner-only.
    //
    // LIST IS DENIED. `allow read: if signedIn()` used to authorise an
    // unfiltered query over this collection, so any Google account could dump
    // every user's name, home timezone and QUIET-HOURS WINDOW — i.e. when each
    // person sleeps (ARCHITECTURE.md §4.1a). No client path queries this
    // collection: every read in the app is `_users.doc(uid)`
    // (profile_repository.dart), so denying `list` costs nothing.
    //
    // Residual, accepted knowingly: a caller who ALREADY KNOWS a uid can still
    // get that profile. Strict "readable only by users who share a group" is
    // not expressible here — rules cannot run queries, so it would need a
    // denormalized `groupIds` on every user doc plus a backfill. What closes it
    // in practice is that no uid leaks to a stranger any more: group docs and
    // rosters are member-gated below, and both collection-group rules at the
    // bottom are resource-scoped to the caller. Firebase uids are 28 random
    // chars, so there is no path to obtain one to try.
    match /users/{uid} {
      // The name is REQUIRED and the server now says so. It used to be enforced
      // only by two widget getters (`_canSave` in profile_edit_screen.dart and
      // complete_profile_screen.dart) — a required field with no server-side
      // enforcement at all, which is the same shape of gap as rule of thumb 2
      // above: the client is not where an invariant lives.
      //
      // Checked on the POST-WRITE document, which is what makes this safe to
      // deploy: `request.resource.data` on an update is the document as it will
      // exist afterwards, so this can only ever block a write that LEAVES the
      // name empty — never the write that repairs one. A user sitting with an
      // empty name is routed to CompleteProfileScreen by `HomeGate` (an empty
      // name fails `UserProfile.isComplete`), whose merge-set on an existing doc
      // is evaluated here as an `update`, and passes the moment it carries a
      // real name.
      //
      // Consequence to know before adding any future write to this document: a
      // merge update that does NOT carry `name` inherits the stored one, so such
      // a write is denied while the stored name is empty — blocked by a field it
      // never touched. Verified 2026-08-15 that no such document exists.
      //
      // `trim()` matches the client's `name.trim().isNotEmpty`. Dart trims the
      // full Unicode whitespace set and this trims less, so a name of exotic
      // whitespace could pass here while the client refuses it — accepted
      // knowingly: the client is the stricter of the two, so the daylight
      // produces no false denials and cannot lock anyone out.
      //
      // No length bound, deliberately. An upper bound here without a matching
      // `maxLength` on the field would turn a valid-looking Save into
      // PERMISSION_DENIED; if one is wanted it lands on both sides together.
      function nameIsPresent() {
        return 'name' in request.resource.data
          && request.resource.data.name is string
          && request.resource.data.name.trim().size() > 0;
      }

      // ---- the social fields (username / bio / isPublic / avatar) ----
      //
      // These live on THIS document because everything here is already
      // readable by any signed-in user who knows the uid — the planner needs
      // the target's name and home timezone, and vice versa. Public-by-nature
      // fields on a public-by-design document cost nothing.
      //
      // WHAT MUST NEVER BE ADDED HERE is anything `isPublic` is supposed to
      // protect. This document's read rule does not consult `isPublic` and
      // cannot: `get` is open to every signed-in caller. Statistics therefore
      // live in the `profileStats` subcollection below, which has its own gated
      // rule. A number parked here "for convenience" would be published to
      // every signed-in user and make the privacy switch a decoration.

      // The handle shown on the profile must be one the user actually HOLDS.
      //
      // Without this, a user could write `username: 'admin'` onto their own
      // document without owning the reservation, and their profile would
      // display a handle belonging to someone else. Search is unaffected (it
      // resolves through `usernames/`), so the damage is impersonation on the
      // profile screen — which is exactly what the reserved-handle list exists
      // to prevent, defeated through a different door.
      //
      // Checked ONLY when `username` actually changes (see the update rule).
      // Re-checking it on every unrelated profile write would spend a get() on
      // each quiet-hours edit, and — worse — would deny every future write if
      // the reservation ever went missing, locking the user out of their own
      // profile over a field they never touched. That is the same trap the
      // `name` note above describes.
      //
      // `UsernameRepository.claim` writes the reservation and this mirror as
      // TWO separate operations for this rule's benefit: rules see committed
      // state only, so a single transaction would be evaluated against a world
      // where the reservation does not exist yet and every claim would fail.
      function usernameIsHeld() {
        return !('username' in request.resource.data)
          || (
            request.resource.data.username is string
            && exists(/databases/$(database)/documents/usernames/$(request.resource.data.username))
            && get(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
          );
      }

      // Bounds mirrored in lib/features/social/presentation/social_profile_editor.dart
      // (bio) and lib/features/social/domain/avatar.dart (sizes). Both sides
      // together, per the note on `name` above: a cap here without a matching
      // `maxLength` on the field turns a valid-looking Save into
      // PERMISSION_DENIED with nothing to explain it.
      function socialFieldsValid() {
        return (!('bio' in request.resource.data)
            || (request.resource.data.bio is string
                && request.resource.data.bio.size() <= 300))
          && (!('isPublic' in request.resource.data)
            || request.resource.data.isPublic is bool)
          && (!('avatar' in request.resource.data)
            || (request.resource.data.avatar.url is string
                && request.resource.data.avatar.sizeBytes is int
                // The animated cap (5MB) — the larger of the two, since the
                // rule cannot tell a GIF from a JPEG without decoding it. The
                // per-format cap is enforced by the Worker, which has the
                // bytes. This is a backstop against a metadata document
                // claiming a size no storage would have accepted.
                && request.resource.data.avatar.sizeBytes <= 5242880
                && request.resource.data.avatar.moderation is string));
      }

      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == uid
        && nameIsPresent()
        && usernameIsHeld()
        && socialFieldsValid();

      allow update: if signedIn()
        && request.auth.uid == uid
        && nameIsPresent()
        && socialFieldsValid()
        && (!changedKeys().hasAny(['username']) || usernameIsHeld());

      allow delete: if false;

      // ---- users/{uid}/profileStats/{doc} ----
      // **The privacy toggle's ONLY teeth.**
      //
      // Everything else about a profile (name, picture, timezone) is readable
      // by uid and always was — the delegation loop needs it. The numbers are
      // the part `isPublic` governs, so they live here, behind a rule that
      // actually reads it.
      //
      // Readable when ALL of:
      //   * neither party has blocked the other — checked FIRST, so a block
      //     out-ranks both friendship and a public profile;
      //   * AND one of: it is your own document / the owner is public / you
      //     are friends.
      //
      // A pending friend request grants NOTHING. If it did, a private profile
      // would be readable by anyone willing to tap Add friend and never follow
      // up — see `profile_visibility.dart`, which mirrors this and is
      // deliberately the stricter of the two.
      //
      // COST, stated plainly: up to three document reads per stats read (two
      // block ids, one friendship id, plus the owner's profile). All are
      // `exists()`/`get()` on COMPUTED ids — never a query — which is the whole
      // reason the ids are deterministic. It is the price of expressing privacy
      // in rules at all, and it is paid only on a profile view.
      //
      // `list` is denied: the collection holds one document (`summary`) at a
      // known id, so nothing needs to enumerate it.
      match /profileStats/{doc} {
        allow get: if signedIn()
          && !blocked(request.auth.uid, uid)
          && (
            request.auth.uid == uid
            || get(/databases/$(database)/documents/users/$(uid)).data.isPublic == true
            || areFriends(request.auth.uid, uid)
          );
        allow list: if false;

        // Owner-only. Publishing someone else's stats would let anyone put any
        // number on anyone's profile — which, on the leaderboard this is built
        // toward, is the entire game.
        allow write: if signedIn() && request.auth.uid == uid;
      }

      // ---- users/{uid}/fcmTokens/{token} ----
      // Per-device FCM tokens (doc id = the token). Owner-only: a user reads and
      // writes only their OWN device tokens. The push Worker/Function reads and
      // cleans these server-side via the service account, which bypasses rules —
      // so no cross-user read is ever opened here.
      match /fcmTokens/{token} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // ---- users/{uid}/state/{doc} ----
      // Per-user, view-only client state. Today the only doc is `archived`
      // (Group D soft-archive): an `items` map of itemId → archivedAt naming
      // the settled items this user has hidden from their OWN views.
      //
      // Owner-only, exactly like fcmTokens above, and that is the whole point of
      // the shape: the archive flag lives in the ARCHIVER's subtree, never on the
      // shared item doc, so a user structurally cannot hide (or un-hide) anything
      // in someone else's view. No cross-user read is opened, and no item write
      // is needed to archive — which is why this rule can be this small.
      //
      // Settled-only is NOT enforced here, deliberately (DECISIONS.md
      // "Group D — CHOSEN"): the flag is per-user and view-only, so a bypass
      // affects only the bypasser's own view — no cross-user and no stats impact.
      // Paying a get() on the item per write to enforce it was explicitly
      // declined. Stats/summaries must read the RECORD (`scheduleItems`), never
      // this filtered view.
      match /state/{doc} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // ---- voiceLibrary/{noteId} (item 32d) ----
      // The owner's saved voice notes. Created and deleted ONLY by the Worker,
      // which keeps each entry and its audio together (every sent note is
      // saved; 20 max, first in first out). The owner reads them and may
      // rename one (1–60 characters) or clear the name back to its date.
      match /voiceLibrary/{noteId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, delete: if false;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && (!('name' in request.resource.data)
              || (request.resource.data.name is string
                  && request.resource.data.name.size() >= 1
                  && request.resource.data.name.size() <= 60));
      }

      // (users/{uid}/trackedTime was removed with Track Time, 2026-09-27 —
      // Batch G item 8. With no rule, any leftover entries are unreadable and
      // unwritable by every client.)
    }

    // ---- groups/{groupId} ----
    // Decision ② (REVISED): the group doc carries name, memberUids and the
    // invite `joinCode`, so it is readable by MEMBERS ONLY. It used to be
    // readable by any signed-in user "so join-by-code can look it up", which
    // authorised listing every group in the project — names, rosters, and every
    // invite code (ARCHITECTURE.md §4.1b). The invite mechanism assumes codes
    // are secret; they were being handed out in bulk.
    //
    // get  — one group by id, members only.
    // list — same predicate, which makes the ONLY satisfiable query
    //        `where('memberUids', array-contains: me)` (watchMyGroups). Both
    //        forms can read `resource.data`, so neither needs a get().
    //
    // A non-member resolves one exact `joinCodes/{code}` document instead of
    // querying this collection. That lookup may create a join request, but can
    // never add the caller to memberUids.
    //
    // Anyone may still create a group as its owner + sole first member.
    // Membership additions are possible only through a unanimously approved
    // joinRequests document. Knowing a code creates a request; it is never a
    // membership capability on its own.
    match /groups/{groupId} {
      allow get: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && (!('adminUids' in request.resource.data)
            || request.resource.data.adminUids == [request.auth.uid])
        && (!('avatar' in request.resource.data)
            || groupAvatarMetadataValid(request.resource.data.avatar, groupId));

      // One approved request, its roster row, and the group array commit in the
      // same atomic write, and the approval is an ADMIN's (item 3: one admin's
      // approval is enough — or an admin's direct add, which is born approved).
      // `lastAdmittedUid` makes the candidate path explicit so rules never
      // trust a caller-supplied document path.
      function isAdminAdmission() {
        let candidateUid = request.resource.data.lastAdmittedUid;
        let admission = getAfter(/databases/$(database)/documents/groups/$(groupId)/joinRequests/$(candidateUid));
        let roster = getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(candidateUid));
        return isAdminOf(resource.data, request.auth.uid)
          && candidateUid is string
          && !(candidateUid in resource.data.memberUids)
          && candidateUid in request.resource.data.memberUids
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && admission.data.candidateUid == candidateUid
          && admission.data.status == 'approved'
          && admission.data.approvalUids == [request.auth.uid]
          && roster.data.name == admission.data.candidateName;
      }

      // The uids this write drops from memberUids.
      function removedUids() {
        return resource.data.memberUids.toSet()
          .difference(request.resource.data.memberUids.toSet());
      }

      // Exactly one member removed, nothing added, never the creator. The
      // remover is that member (leaving) or an admin (removing — including
      // another admin). A removed admin leaves `adminUids` in the same write.
      function isMemberRemoval() {
        return resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && removedUids().size() == 1
          && !removedUids().hasAny([resource.data.ownerUid])
          && (removedUids().hasOnly([request.auth.uid])
              || isAdminOf(resource.data, request.auth.uid))
          && request.resource.data.get('adminUids', []).toSet()
               == resource.data.get('adminUids', []).toSet().difference(removedUids());
      }

      // Only the CREATOR makes or removes admins, and only among members. The
      // creator stays an admin whatever the list says.
      function isAdminChange() {
        return request.auth.uid == resource.data.ownerUid
          && request.resource.data.adminUids is list
          && request.resource.data.adminUids.size()
               == request.resource.data.adminUids.toSet().size()
          && request.resource.data.memberUids.hasAll(request.resource.data.adminUids);
      }

      allow update: if signedIn()
        && (
          (changedKeys().hasOnly(['memberUids', 'adminUids']) && isMemberRemoval())
          || (changedKeys().hasOnly(['memberUids', 'lastAdmittedUid'])
              && isAdminAdmission())
          || (changedKeys().hasOnly(['adminUids']) && isAdminChange())
          || (request.auth.uid == resource.data.ownerUid
              && changedKeys().hasOnly(['avatar'])
              && (!('avatar' in request.resource.data)
                  || groupAvatarMetadataValid(
                      request.resource.data.avatar, groupId)))
        );

      allow delete: if false;

      // ---- joinRequests/{candidateUid} ----
      // Item 3 (WhatsApp-style). Three ways a request is born:
      //   * `code`   — the candidate entered the invite code: PENDING;
      //   * `friend` — a non-admin member invited one of THEIR friends: PENDING;
      //   * `admin`  — an admin added one of their friends: born APPROVED, in the
      //                same batch as the admission (they join at once).
      // A pending request is decided by ANY ONE admin: approve (admits, atomic
      // with the roster) or reject. Every admin is pushed (Worker
      // `groupJoinRequested`). `requiredApproverUids` is kept empty for shape
      // compatibility with the retired unanimous flow.
      match /joinRequests/{candidateUid} {
        function exactRequestKeys() {
          return request.resource.data.keys().hasOnly([
            'candidateUid', 'candidateName', 'requestedByUid', 'source',
            'inviteCode', 'status', 'requiredApproverUids', 'approvalUids',
            'rejectionUid', 'createdAt', 'updatedAt',
            'notifiedApproved', 'notifiedApprovedAt',
            'notifiedRequested', 'notifiedRequestedAt'
          ]);
        }

        function candidateNameIsReal() {
          return request.resource.data.candidateName is string
            && exists(/databases/$(database)/documents/users/$(candidateUid))
            && request.resource.data.candidateName ==
               get(/databases/$(database)/documents/users/$(candidateUid)).data.name;
        }

        function isCodeRequest() {
          let code = request.resource.data.inviteCode;
          return request.auth.uid == candidateUid
            && request.resource.data.requestedByUid == candidateUid
            && request.resource.data.source == 'code'
            && code is string
            && exists(/databases/$(database)/documents/joinCodes/$(code))
            && get(/databases/$(database)/documents/joinCodes/$(code)).data.groupId == groupId
            && request.resource.data.status == 'pending'
            && request.resource.data.approvalUids == [];
        }

        function isMemberInvitation() {
          return callerInGroup(groupId)
            && request.resource.data.requestedByUid == request.auth.uid
            && request.resource.data.source == 'friend'
            && request.resource.data.inviteCode == null
            && areFriends(request.auth.uid, candidateUid)
            && request.resource.data.status == 'pending'
            && request.resource.data.approvalUids == [];
        }

        // An admin adds a friend directly. Born approved, and only valid inside
        // the admission batch (the group array must gain exactly this person).
        function isAdminDirectAdd() {
          return callerIsGroupAdmin(groupId)
            && request.resource.data.requestedByUid == request.auth.uid
            && request.resource.data.source == 'admin'
            && request.resource.data.inviteCode == null
            && areFriends(request.auth.uid, candidateUid)
            && request.resource.data.status == 'approved'
            && request.resource.data.approvalUids == [request.auth.uid]
            && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.lastAdmittedUid == candidateUid
            && candidateUid in getAfter(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        }

        allow get: if signedIn()
          && (request.auth.uid == candidateUid || callerInGroup(groupId));
        allow list: if callerInGroup(groupId);

        allow create: if signedIn()
          && candidateUid == request.resource.data.candidateUid
          && !(candidateUid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids)
          && exactRequestKeys()
          && candidateNameIsReal()
          && request.resource.data.requiredApproverUids == []
          && request.resource.data.rejectionUid == null
          && (isCodeRequest() || isMemberInvitation() || isAdminDirectAdd());

        function immutableRequestFields() {
          return request.resource.data.candidateUid == resource.data.candidateUid
            && request.resource.data.candidateName == resource.data.candidateName
            && request.resource.data.requestedByUid == resource.data.requestedByUid
            && request.resource.data.source == resource.data.source
            && request.resource.data.inviteCode == resource.data.inviteCode
            && request.resource.data.createdAt == resource.data.createdAt;
        }

        function isRejection() {
          return request.resource.data.status == 'rejected'
            && request.resource.data.rejectionUid == request.auth.uid
            && changedKeys().hasOnly(['status', 'rejectionUid', 'updatedAt']);
        }

        // One admin's approval admits — atomic with the group array + roster.
        function isApproval() {
          return request.resource.data.status == 'approved'
            && request.resource.data.approvalUids == [request.auth.uid]
            && request.resource.data.rejectionUid == null
            && changedKeys().hasOnly([
                 'status', 'approvalUids', 'requiredApproverUids', 'updatedAt'])
            && request.resource.data.requiredApproverUids == []
            && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.lastAdmittedUid == candidateUid
            && candidateUid in getAfter(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
            && getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(candidateUid)).data.name
               == resource.data.candidateName;
        }

        allow update: if signedIn()
          && callerIsGroupAdmin(groupId)
          && resource.data.status == 'pending'
          && exactRequestKeys()
          && immutableRequestFields()
          && (isRejection() || isApproval());

        allow delete: if false;
      }

      // ---- members/{memberUid} ----
      // Roster is relationship-gated: only group members may read it. A user may
      // write their own row once they are a member; the other permitted create
      // is the atomic admin-admission batch validated above.
      match /members/{memberUid} {
        allow read: if callerInGroup(groupId);
        allow create: if signedIn()
          && (
            (memberUid == request.auth.uid && callerInGroup(groupId))
            || (
              callerIsGroupAdmin(groupId)
              && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.lastAdmittedUid == memberUid
              && memberUid in getAfter(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
              && getAfter(/databases/$(database)/documents/groups/$(groupId)/joinRequests/$(memberUid)).data.status == 'approved'
              && request.resource.data.keys().hasOnly(['name', 'joinedAt'])
              && request.resource.data.name ==
                 getAfter(/databases/$(database)/documents/groups/$(groupId)/joinRequests/$(memberUid)).data.candidateName
            )
          );
        allow update: if signedIn()
          && memberUid == request.auth.uid
          && callerInGroup(groupId);

        // Removal deletes the roster doc BEFORE memberUids is updated, while
        // the caller is still a member — callerInGroup() gates this, so the
        // reverse order would lock the caller out of their own cleanup. The
        // creator's doc is never deletable, mirroring isMemberRemoval(); any
        // admin may remove anyone else (item 3).
        allow delete: if signedIn()
          && callerInGroup(groupId)
          && memberUid != groupOwnerUid(groupId)
          && (memberUid == request.auth.uid || callerIsGroupAdmin(groupId));
      }

      // ---- memberStats/{uid} ----
      // Group accountability + leaderboard (DECISIONS.md "Group accountability
      // + leaderboard"). Each member PUBLISHES their own summary here so fellow
      // members can see shared follow-through and a ranked board — the same
      // "published, not derived" doctrine as `users/{uid}/profileStats`, and for
      // the same reason: a group member cannot read another member's items, nor
      // their friend-gated profileStats. So the owner's device writes the small
      // summary and any group member reads it.
      //
      // WRITE is self-only (`uid == caller`) and member-only, so no one can
      // forge another member's numbers. READ is any group member. The values
      // are unverifiable by rules (they summarise a subtree only the writer can
      // read) — but they describe only the writer's OWN record, so a member
      // inflating their own board position is the ceiling, not reading anyone
      // else's data.
      //
      // Item 24d (2026-09-27): the numbers are GROUP-SCOPED (only plans tagged
      // with this group) and the shape changed: `answered` + `bestStreak` are
      // REQUIRED and `followThrough` is gone (readers derive it from
      // tasksCompleted ÷ answered, so a small sample is never stored as a
      // misleading 0). Requiring `answered` rejects pre-24d builds, which
      // would overwrite the group numbers with personal ones. An admin may
      // delete a member's row, so removing someone takes them off the board.
      match /memberStats/{uid} {
        allow read: if callerInGroup(groupId);
        allow create, update: if signedIn()
          && uid == request.auth.uid
          && callerInGroup(groupId)
          && request.resource.data.keys().hasOnly(
               ['name', 'tasksCompleted', 'answered', 'currentStreak',
                'bestStreak', 'updatedAt'])
          && request.resource.data.keys().hasAll(
               ['name', 'tasksCompleted', 'answered', 'currentStreak',
                'bestStreak'])
          && request.resource.data.name is string
          && request.resource.data.tasksCompleted is int
          && request.resource.data.answered is int
          && request.resource.data.currentStreak is int
          && request.resource.data.bestStreak is int
          && request.resource.data.tasksCompleted >= 0
          && request.resource.data.tasksCompleted <= request.resource.data.answered
          && request.resource.data.currentStreak >= 0
          && request.resource.data.currentStreak <= request.resource.data.bestStreak;
        allow delete: if signedIn()
          && (uid == request.auth.uid || callerIsGroupAdmin(groupId));
      }

      // ---- plannerGrants/{grantId} — RETIRED (item 3, 2026-09-27) ----
      // Any member may plan for the group and friends need nothing, so group
      // grants authorize nothing and can no longer be written. Leftovers stay
      // readable to members (the collection-group rule below serves the
      // planner's own query).
      match /plannerGrants/{grantId} {
        allow read: if callerInGroup(groupId);
      }
    }

    // ---- usernames/{handle} ----
    // The uniqueness primitive. Firestore has no unique index and rules cannot
    // run a query, so uniqueness is built out of the one thing that IS atomic:
    // a document id. The canonical (lowercased) handle IS the id, so two people
    // racing for one handle race for one document.
    //
    // This is the same shape as `joinCodes/{code}` below, and closes the same
    // class of hole. There it stops group enumeration; here it stops USER
    // enumeration.
    //
    // get    — resolve a handle you were given. Yields a uid, which grants
    //          nothing on its own: profiles are per-uid gets, stats are gated,
    //          and schedules are unreachable.
    // list   — DENIED, and this is the load-bearing half. `users` already has
    //          `list: if false` because listing it leaked every user's name,
    //          home timezone and QUIET-HOURS WINDOW — when each person sleeps.
    //          Allowing list here would rebuild that capability one hop away:
    //          sweep the handles, get each uid, get each profile. It is also
    //          why the app's search is exact-match only, which
    //          `user_search_screen.dart` explains to the user rather than
    //          leaving them to conclude search is broken.
    // create — claim a free handle for YOURSELF. `uid` must be the caller, so a
    //          handle cannot be reserved on someone else's behalf.
    // update — DENIED. A reservation is never repointed at another uid; a
    //          rename is a create of the new plus a delete of the old.
    // delete — release a handle you hold. Only its owner.
    match /usernames/{handle} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        // Re-claiming your own is fine; taking someone else's is not. Firestore
        // treats a `set` on an existing doc as an update, so this branch only
        // ever sees a genuinely free handle — the update rule below covers the
        // idempotent re-claim.
        && handle.size() >= 3
        && handle.size() <= 20;

      // The idempotent re-claim: writing the same reservation you already hold.
      // Permitted so `claim()` can be re-run after a failure between its two
      // steps without special-casing; it can only ever be a no-op.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- friendRequests/{requestId} ----
    // A DIRECTED request, at the computed id `{fromUid}_{toUid}`. Deterministic
    // rather than auto-id so sending twice is idempotent and so the rules have
    // an address to check rather than a query to run.
    //
    // The id is verified against the payload on create — otherwise a caller
    // could write a request from themselves at an id naming two other people,
    // and the recipient's inbox query (`toUid == me`) would surface a document
    // whose id said something else entirely.
    //
    // read   — either party, and only those two.
    // create — the SENDER only, as `pending`, with neither party blocking the
    //          other. The block check is what makes blocking mean anything: a
    //          blocked person must not be able to keep knocking.
    // update — three transitions, each scoped to who may make it:
    //            * recipient → accepted | rejected  (the decision is theirs)
    //            * either party → cancelled          (withdraw / clear)
    //          A `rejected` row can be cancelled but NEVER revived to
    //          `pending`, which is what stops "no" being a button that does
    //          nothing: re-asking means the recipient clearing it first.
    // delete — DENIED. The row is the record. See FriendRequestStatus.
    match /friendRequests/{requestId} {
      function fromUid() { return resource.data.fromUid; }
      function toUid()   { return resource.data.toUid; }
      function isParty() {
        return request.auth.uid == fromUid() || request.auth.uid == toUid();
      }

      allow read: if signedIn() && isParty();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'fromUid', 'toUid', 'participants', 'status',
             'createdAt', 'updatedAt'
           ])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        // The id must BE the pair it claims to describe.
        && requestId == request.resource.data.fromUid + '_' + request.resource.data.toUid
        && request.resource.data.participants.hasOnly([
             request.resource.data.fromUid, request.resource.data.toUid
           ])
        && request.resource.data.status == 'pending'
        && !blocked(request.auth.uid, request.resource.data.toUid);

      allow update: if signedIn()
        && isParty()
        // Immutable identity: the parties and the id never change.
        && request.resource.data.fromUid == fromUid()
        && request.resource.data.toUid == toUid()
        && changedKeys().hasOnly(['status', 'decidedAt', 'updatedAt'])
        && (
          // The recipient decides. Only on a request that is still open —
          // this is what stops a decided row being re-decided.
          (
            request.auth.uid == toUid()
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'rejected']
          )
          // Either party clears it. Never FROM accepted: a friendship exists at
          // that point, and unfriending is deleting that document, not
          // rewriting this one.
          || (
            request.resource.data.status == 'cancelled'
            && resource.data.status in ['pending', 'rejected']
          )
        );

      // Either party may delete the request. This is how a decline (recipient)
      // and a withdraw (sender) now work: the row is removed, not flagged, so
      // the pair is immediately re-requestable and the decline is not left as a
      // detectable record. Deleting grants nothing and reveals nothing — the
      // consent model is unchanged; only the lifecycle is. A block still can't
      // be side-stepped, because creating the fresh request re-checks `blocked`.
      // See DECISIONS.md "Friend-request reactivity + lifecycle (2026-08-24)".
      allow delete: if signedIn() && isParty();
    }

    // ---- friendships/{pairId} ----
    // ONE document per pair, at the SORTED id (see sortedPairId() above). Symmetric
    // by construction: both parties compute the same address, so there is no
    // state in which one of them thinks they are friends and the other does
    // not, and no half-edge to leave behind on removal.
    //
    // **This is the document every privacy rule reads.** Its shape is dictated
    // by that: `exists()` on a computed id, no query, no status field.
    //
    // read   — either party. Scoped so the LIST query
    //          (`participants array-contains me`) returns only the caller's own
    //          friendships and the social graph cannot be enumerated. The cost:
    //          another user's friend count is not knowable from a client, which
    //          `friendCountForProvider` records rather than works around.
    // create — the ACCEPTING party, and only against a real pending request
    //          addressed to them. This is the one place a friendship can come
    //          into existence, so it carries the whole consent story: you
    //          cannot befriend someone who did not ask.
    // update — DENIED. There is nothing on this document to change.
    // delete — either party, unilaterally. Unfriending needs no agreement.
    match /friendships/{pairId} {
      function isParty() {
        return request.auth.uid in resource.data.participants;
      }

      allow read: if signedIn() && isParty();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'uidA', 'uidB', 'participants', 'createdAt'
           ])
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        // The id must be the sorted pair of the two named uids, or the document
        // would be unfindable by the very rules that depend on computing it.
        && sortedPairId(request.resource.data.uidA, request.resource.data.uidB) == pairId
        && request.resource.data.participants.hasOnly([
             request.resource.data.uidA, request.resource.data.uidB
           ])
        && request.resource.data.uidA != request.resource.data.uidB
        && !blocked(request.resource.data.uidA, request.resource.data.uidB)
        // There must be a PENDING request from the other person to the caller.
        // Reading the request rather than trusting the caller is what keeps
        // consent real: without it, anyone could make themselves your friend
        // and read your private stats.
        && exists(/databases/$(database)/documents/friendRequests/$(otherParty(request.resource.data.participants) + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/friendRequests/$(otherParty(request.resource.data.participants) + '_' + request.auth.uid)).data.status == 'pending';

      allow update: if false;
      allow delete: if signedIn() && isParty();
    }

    // ---- RETIRED: friendship plannerGrants / emergencyGrants, planningRequests
    // Friendship itself is the permission now (see `callerIsFriendOf`). These
    // documents authorize nothing and can no longer be written; the parties may
    // still read and delete leftovers, so an older installed build's unfriend
    // cleanup keeps working. (DECISIONS.md "Friendship is the planning
    // permission".)
    match /friendships/{pairId}/plannerGrants/{grantId} {
      allow read, delete: if signedIn()
        && (resource.data.plannerUid == request.auth.uid
            || resource.data.targetUid == request.auth.uid);
    }

    match /friendships/{pairId}/emergencyGrants/{grantId} {
      allow read, delete: if signedIn()
        && (resource.data.plannerUid == request.auth.uid
            || resource.data.targetUid == request.auth.uid);
    }

    match /planningRequests/{requestId} {
      allow read, delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
    }

    // ---- planRequests/{batchId}_{plannerUid} ----
    // A request for one or more ACTUAL plans (Item 23), not a request for a
    // planning grant. The requester is the schedule target and may fan one
    // batch out to several friends. Each recipient gets an independent row so
    // retries are deterministic and one person's decision cannot mutate
    // another person's request.
    match /planRequests/{planRequestId} {
      function requesterUid() { return resource.data.requesterUid; }
      function plannerUid() { return resource.data.plannerUid; }
      function isParty() {
        return request.auth.uid == requesterUid()
          || request.auth.uid == plannerUid();
      }
      function identityUnchanged() {
        return request.resource.data.requesterUid == requesterUid()
          && request.resource.data.plannerUid == plannerUid()
          && request.resource.data.batchId == resource.data.batchId
          && request.resource.data.mode == resource.data.mode
          && request.resource.data.timezone == resource.data.timezone
          && request.resource.data.windowStartUtc == resource.data.windowStartUtc
          && request.resource.data.windowEndUtc == resource.data.windowEndUtc
          && request.resource.data.durationMinutes == resource.data.durationMinutes;
      }

      allow get, list: if signedIn() && isParty();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'batchId', 'requesterUid', 'plannerUid', 'participantUids',
             'mode', 'status', 'timezone', 'windowStartUtc', 'windowEndUtc',
             'durationMinutes', 'title', 'message', 'fulfilledSpans',
             'fulfilledItemIds', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.plannerUid is string
        && request.resource.data.plannerUid != request.auth.uid
        && planRequestId == request.resource.data.batchId + '_'
             + request.resource.data.plannerUid
        && request.resource.data.participantUids.hasOnly([
             request.resource.data.requesterUid,
             request.resource.data.plannerUid
           ])
        // Item 5 redesign (2026-09-27): a request is ONE reminder at ONE
        // minute — onePlan, a one-minute window, a one-minute plan — with the
        // task named. (Flexible windows can no longer be created; any still
        // open keep working through the update/fulfilment rules.)
        && request.resource.data.mode == 'onePlan'
        && request.resource.data.durationMinutes == 1
        && request.resource.data.windowEndUtc
             == request.resource.data.windowStartUtc + duration.value(1, 'm')
        && request.resource.data.title is string
        && request.resource.data.title.trim().size() > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.timezone is string
        && request.resource.data.timezone.size() > 0
        && request.resource.data.windowStartUtc is timestamp
        && request.resource.data.windowEndUtc is timestamp
        && request.resource.data.windowEndUtc
             > request.resource.data.windowStartUtc
        && request.resource.data.windowStartUtc > request.time
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes >= 1
        && request.resource.data.durationMinutes <= 1440
        && request.resource.data.windowStartUtc
             + duration.value(request.resource.data.durationMinutes, 'm')
             <= request.resource.data.windowEndUtc
        && request.resource.data.fulfilledSpans == []
        && request.resource.data.fulfilledItemIds == []
        && (!('title' in request.resource.data)
            || (request.resource.data.title is string
                && request.resource.data.title.size() <= 200))
        && (!('message' in request.resource.data)
            || (request.resource.data.message is string
                && request.resource.data.message.size() <= 500))
        // You ask a FRIEND. The request grants nothing: friendship is already
        // the planning permission (callerIsFriendOf).
        && areFriends(request.resource.data.plannerUid, request.auth.uid);

      allow update: if signedIn()
        && isParty()
        && identityUnchanged()
        && changedKeys().hasOnly([
             'status', 'fulfilledSpans', 'fulfilledItemIds',
             'lastFulfilledItemId', 'settledByUid', 'updatedAt'
           ])
        && (
          // The requester may cancel an open request, but cannot edit its
          // contents or erase already-created item provenance.
          (request.auth.uid == requesterUid()
            && resource.data.status in ['pending', 'inProgress']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.settledByUid == request.auth.uid
            && request.resource.data.fulfilledSpans
                 == resource.data.fulfilledSpans
            && request.resource.data.fulfilledItemIds
                 == resource.data.fulfilledItemIds
            && request.resource.data.get('lastFulfilledItemId', '')
                 == resource.data.get('lastFulfilledItemId', ''))
          ||
          // The selected planner may decline without creating anything.
          (request.auth.uid == plannerUid()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'declined'
            && request.resource.data.settledByUid == request.auth.uid
            && request.resource.data.fulfilledSpans == []
            && request.resource.data.fulfilledItemIds == []
            && request.resource.data.get('lastFulfilledItemId', '')
                 == resource.data.get('lastFulfilledItemId', ''))
          ||
          // Or append exactly one item in the same atomic transaction. The
          // item rule below checks the reverse link and the live normal grant.
          (request.auth.uid == plannerUid()
            && resource.data.status in ['pending', 'inProgress']
            && request.resource.data.status in ['inProgress', 'fulfilled']
            && request.resource.data.fulfilledSpans is list
            && request.resource.data.fulfilledItemIds is list
            && request.resource.data.fulfilledSpans.size()
                 == resource.data.fulfilledSpans.size() + 1
            && request.resource.data.fulfilledItemIds.size()
                 == resource.data.fulfilledItemIds.size() + 1
            && request.resource.data.fulfilledSpans
                 .hasAll(resource.data.fulfilledSpans)
            && request.resource.data.fulfilledItemIds
                 .hasAll(resource.data.fulfilledItemIds)
            && request.resource.data.lastFulfilledItemId is string
            && request.resource.data.lastFulfilledItemId
                 in request.resource.data.fulfilledItemIds
            // The appended span is exact, chronological, and agrees with the
            // item. Sorted append turns non-overlap into a bounded rules check:
            // the new start only needs to be at/after the previous end.
            && request.resource.data.fulfilledSpans[
                 resource.data.fulfilledSpans.size()].keys().hasOnly([
                   'itemId', 'startUtc', 'durationMinutes'
                 ])
            && request.resource.data.fulfilledSpans[
                 resource.data.fulfilledSpans.size()].itemId
                 == request.resource.data.lastFulfilledItemId
            && request.resource.data.fulfilledSpans[
                 resource.data.fulfilledSpans.size()].startUtc is timestamp
            && request.resource.data.fulfilledSpans[
                 resource.data.fulfilledSpans.size()].durationMinutes is int
            && request.resource.data.fulfilledSpans[
                 resource.data.fulfilledSpans.size()].durationMinutes >= 1
            && request.resource.data.fulfilledSpans[
                 resource.data.fulfilledSpans.size()].durationMinutes <= 1440
            && request.resource.data.fulfilledSpans[
                 resource.data.fulfilledSpans.size()].startUtc
                 >= resource.data.windowStartUtc
            && request.resource.data.fulfilledSpans[
                 resource.data.fulfilledSpans.size()].startUtc
                 + duration.value(request.resource.data.fulfilledSpans[
                     resource.data.fulfilledSpans.size()].durationMinutes, 'm')
                 <= resource.data.windowEndUtc
            && (resource.data.fulfilledSpans.size() == 0
                || request.resource.data.fulfilledSpans[
                     resource.data.fulfilledSpans.size()].startUtc
                   >= resource.data.fulfilledSpans[
                     resource.data.fulfilledSpans.size() - 1].startUtc
                     + duration.value(resource.data.fulfilledSpans[
                         resource.data.fulfilledSpans.size() - 1]
                         .durationMinutes, 'm'))
            && existsAfter(/databases/$(database)/documents/scheduleItems/$(requesterUid())/items/$(request.resource.data.lastFulfilledItemId))
            && getAfter(/databases/$(database)/documents/scheduleItems/$(requesterUid())/items/$(request.resource.data.lastFulfilledItemId)).data.planRequestId
                 == planRequestId
            && getAfter(/databases/$(database)/documents/scheduleItems/$(requesterUid())/items/$(request.resource.data.lastFulfilledItemId)).data.scheduledInstantUtc
                 == request.resource.data.fulfilledSpans[
                      resource.data.fulfilledSpans.size()].startUtc
            && getAfter(/databases/$(database)/documents/scheduleItems/$(requesterUid())/items/$(request.resource.data.lastFulfilledItemId)).data.durationMinutes
                 == request.resource.data.fulfilledSpans[
                      resource.data.fulfilledSpans.size()].durationMinutes
            && (resource.data.mode != 'onePlan'
                || request.resource.data.fulfilledSpans[
                     resource.data.fulfilledSpans.size()].durationMinutes
                   == resource.data.durationMinutes)
            && (request.resource.data.status != 'fulfilled'
                || request.resource.data.settledByUid == request.auth.uid)
            && (resource.data.mode != 'onePlan'
                || request.resource.data.status == 'fulfilled'))
          ||
          // A flexible request with at least one item can be closed later
          // without fabricating another item.
          (request.auth.uid == plannerUid()
            && resource.data.mode == 'flexibleWindow'
            && resource.data.status == 'inProgress'
            && request.resource.data.status == 'fulfilled'
            && request.resource.data.settledByUid == request.auth.uid
            && request.resource.data.fulfilledSpans
                 == resource.data.fulfilledSpans
            && request.resource.data.fulfilledItemIds
                 == resource.data.fulfilledItemIds
            && request.resource.data.get('lastFulfilledItemId', '')
                 == resource.data.get('lastFulfilledItemId', ''))
        );

      allow delete: if false;
    }

    // ---- blocks/{blockId} ----
    // A one-way record at `{blockerUid}_{blockedUid}`, enforced both ways by
    // blocked() above.
    //
    // get    — EITHER party. The blocked side needs this: the client has to
    //          know it is blocked in order to render the profile as
    //          unavailable, and `users/{uid}` stays readable by uid regardless.
    //          THE COST, NAMED: a determined reader can detect that they were
    //          blocked by fetching a computed id. The UI never tells them — a
    //          block and a missing account render identically
    //          (`AppIcons.profileUnavailable`) — but this is a UI property, not
    //          a data one. Closing it would mean the blocked client could not
    //          hide the profile at all, which is worse.
    // list   — the BLOCKER only, so nobody can enumerate who has blocked them.
    // create — the blocker, naming themselves.
    // update — DENIED. A block is not edited; it is placed or lifted.
    // delete — the blocker only. Being blocked is not something you can undo.
    match /blocks/{blockId} {
      allow get: if signedIn()
        && (resource.data.blockerUid == request.auth.uid
            || resource.data.blockedUid == request.auth.uid);
      allow list: if signedIn() && resource.data.blockerUid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'blockerUid', 'blockedUid', 'createdAt'
           ])
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid
        && blockId == request.resource.data.blockerUid + '_' + request.resource.data.blockedUid;

      allow update: if false;
      allow delete: if signedIn() && resource.data.blockerUid == request.auth.uid;
    }

    // ---- joinCodes/{code} ----
    // Invite-code → groupId lookup. This exists so join-by-code needs NO read
    // on the group doc, which is what lets the group doc go members-only above.
    // The code itself is the capability: you can resolve a code you already
    // hold, and nothing else.
    //
    // get    — resolve one code you were given. A resolved code yields ONLY a
    //          group id, which grants nothing on its own: the group doc, its
    //          roster and its grants are all member-gated. It permits only a
    //          pending join request, which every current member must approve.
    // list   — DENIED, so codes can never be swept in bulk. This is the whole
    //          point: brute-forcing 6 chars from a 32-char no-lookalike
    //          alphabet is ~10^9 single gets, versus one query before.
    // create — the group's OWNER registers their own code.
    // update/delete — never. A code must not be repointed at another group.
    //
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['groupId'])
        && request.resource.data.groupId is string
        && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
             .data.ownerUid == request.auth.uid;

      allow update, delete: if false;
    }

    // ---- voiceUploads/{itemId} ----
    // Written ONLY by the Worker (service account) after it has checked the
    // audio; read only by these rules (get() inside voiceNoteIsValidOnCreate).
    match /voiceUploads/{itemId} {
      allow read, write: if false;
    }

    // ---- completionCelebrations/{targetUid_itemId}[_skipped] ----
    // Durable, per-participant delivery for the 1.4-second completion effect
    // AND the planner's in-app outcome pop-up (2026-09-26). The target creates
    // it atomically with the outcome: a DONE record (`{t}_{i}`, both parties,
    // confetti + the planner's pop-up) or a SKIPPED record (`{t}_{i}_skipped`,
    // planner only, pop-up without confetti). Separate ids so the missed-alarm
    // "Skip → Done" correction can still create its Done record. Each
    // participant may acknowledge only themselves; the last unseen deletes it.
    match /completionCelebrations/{celebrationId} {
      function itemBefore() {
        return get(/databases/$(database)/documents/scheduleItems/$(request.resource.data.targetUid)/items/$(request.resource.data.itemId));
      }

      function itemAfter() {
        return getAfter(/databases/$(database)/documents/scheduleItems/$(request.resource.data.targetUid)/items/$(request.resource.data.itemId));
      }

      function exactKeys() {
        return request.resource.data.keys().hasOnly([
          'itemId', 'targetUid', 'plannerUid', 'participantUids',
          'seenByUids', 'createdAt', 'result'
        ]);
      }

      // Absent = a Done record written by a pre-2026-09-26 client.
      function isDoneRecord() {
        return request.resource.data.get('result', 'done') == 'done'
          && celebrationId == request.resource.data.targetUid + '_' + request.resource.data.itemId
          && request.resource.data.participantUids is list
          && request.resource.data.participantUids.toSet().size()
               == request.resource.data.participantUids.size()
          && request.resource.data.targetUid in request.resource.data.participantUids
          && request.resource.data.plannerUid in request.resource.data.participantUids
          && request.resource.data.participantUids.size()
               == (request.resource.data.targetUid == request.resource.data.plannerUid ? 1 : 2)
          && priorItemAllowsDone()
          && itemAfter().data.outcome.result == 'done';
      }

      // A first-write Skip, announced to a planner who is someone else.
      function isSkipRecord() {
        return request.resource.data.get('result', 'done') == 'skipped'
          && celebrationId == request.resource.data.targetUid + '_' + request.resource.data.itemId + '_skipped'
          && request.resource.data.plannerUid != request.resource.data.targetUid
          && request.resource.data.participantUids == [request.resource.data.plannerUid]
          && !itemBefore().data.keys().hasAny(['outcome'])
          && itemAfter().data.outcome.result == 'skipped';
      }

      function priorItemAllowsDone() {
        let before = itemBefore().data;
        let outcome = before.get('outcome', {});
        return !before.keys().hasAny(['outcome'])
          || (
            outcome is map
            && outcome.get('result', '') == 'skipped'
            && outcome.get('skipReason', '') == 'User unavailable'
          );
      }

      allow get: if signedIn()
        && request.auth.uid in resource.data.participantUids;
      allow list: if signedIn()
        && request.auth.uid in resource.data.participantUids;

      allow create: if signedIn()
        && exactKeys()
        && request.auth.uid == request.resource.data.targetUid
        && request.resource.data.seenByUids == []
        && itemAfter().data.targetUid == request.resource.data.targetUid
        && itemAfter().data.createdByUid == request.resource.data.plannerUid
        && (isDoneRecord() || isSkipRecord());

      allow update: if signedIn()
        && request.auth.uid in resource.data.participantUids
        && changedKeys().hasOnly(['seenByUids'])
        && request.resource.data.seenByUids is list
        && request.resource.data.seenByUids.toSet().size()
             == request.resource.data.seenByUids.size()
        && request.resource.data.seenByUids.toSet()
             .difference(resource.data.participantUids.toSet()).size() == 0
        && request.resource.data.seenByUids.toSet()
             .hasAll(resource.data.seenByUids.toSet())
        && request.resource.data.seenByUids.toSet()
             .difference(resource.data.seenByUids.toSet())
             .hasOnly([request.auth.uid])
        && request.auth.uid in request.resource.data.seenByUids;

      allow delete: if signedIn()
        && request.auth.uid in resource.data.participantUids
        && resource.data.participantUids.toSet()
             .difference(resource.data.seenByUids.toSet())
             .hasOnly([request.auth.uid]);
    }

    // ---- scheduleItems/{targetUid}/items/{itemId} ----
    // This SPECIFIC-path rule serves the TARGET's own subtree (their pending
    // queue / approved items) via direct, path-scoped reads, plus item writes.
    // The PLANNER's cross-target read is a COLLECTION-GROUP query and is NOT
    // matched by a specific parent path — it is handled by the /{path=**}/items
    // rule at the bottom. (Verified on the emulator; see DECISIONS.md.)
    // Create: the creator is either the target themselves (self-planning) or a
    //   planner holding an ACTIVE grant over the target in the item's group.
    //   createdByUid and targetUid cannot be forged (must equal caller / path).
    //   Initial `status` is CONSTRAINED, and this is a security fix in its own
    //   right (independent of self-planning): a planner must NOT be able to
    //   write an item already `approved`, which would bypass the target's
    //   per-item approval. So —
    //     • planner path (grant): may create `pending` ONLY.
    //     • self path (creator == target): may create `pending` or `approved`
    //       (self-authored items skip the queue; consent is inherent).
    // Update: TARGET does the full set — approve / reject / mark done / skipped.
    //   The PLANNER (creator) gets ONE tightly-scoped write: withdraw a plan
    //   they created while it is still `pending` (Group C). That is the only
    //   item write a non-target may make. Planner edit is still deferred.
    //
    // EVERY write here is FIELD-SCOPED, and the reason is the push Worker. Its
    // duplicate guard reads `notifiedCreated` / `notifiedDecided` /
    // `notifiedOutcome` / `notifiedWithdrawn` off THIS document (notify.js).
    // While the rules only checked WHO was writing, a target could pre-write
    // `notifiedOutcome: 'done'` — or a planner could create an item already
    // stamped `notifiedCreated: true` — and the Worker would answer
    // `already-notified` and send nothing. In an accountability app, silently
    // suppressing the notification is the one thing the design must not allow
    // (ARCHITECTURE.md §4.1c).
    //
    // So the `notified*` fields appear in NO whitelist below. Only the Worker
    // writes them, via a service-account token that bypasses these rules. The
    // field scoping also stops a target rewriting `title`,
    // `scheduledInstantUtc` or `createdByUid` after the fact.
    match /scheduleItems/{targetUid}/items/{itemId} {
      function alarmTimelineIsValid() {
        let before = resource.data.get('alarm', {});
        let after = request.resource.data.get('alarm', {});
        return !changedKeys().hasAny(['alarm'])
          || (
            before is map
            && after is map
            && after.keys().hasOnly(
                 ['rangAt', 'dismissedAt', 'unavailableAt', 'voiceFallbackAt'])
            // Item 32c-2: the voice note could not play, the ringtone rang.
            && (!after.keys().hasAny(['voiceFallbackAt'])
                || after.get('voiceFallbackAt', null) is timestamp)
            && (!after.keys().hasAny(['rangAt'])
                || after.get('rangAt', null) is timestamp)
            && (!after.keys().hasAny(['dismissedAt'])
                || after.get('dismissedAt', null) is timestamp)
            && (!after.keys().hasAny(['unavailableAt'])
                || after.get('unavailableAt', null) is timestamp)
            && (
              !before.keys().hasAny(['unavailableAt'])
              || (
                after.keys().hasAny(['unavailableAt'])
                && after.get('unavailableAt', null)
                   == before.get('unavailableAt', null)
              )
            )
          );
      }

      // Voice-note alarms (item 32a). The item carries only metadata, and it
      // must match the upload record the Worker wrote after checking the
      // audio itself (`voiceUploads/{itemId}`): same uploader (the creator),
      // same target, same hash. Only on someone ELSE's plan.
      function voiceNoteIsValidOnCreate() {
        let note = request.resource.data.get('voiceNote', null);
        let upload = /databases/$(database)/documents/voiceUploads/$(itemId);
        return note == null
          || (
            request.resource.data.createdByUid != targetUid
            && note is map
            && note.keys().hasOnly(['durationMs', 'sha256', 'sizeBytes'])
            && note.durationMs is int
            && note.durationMs > 0 && note.durationMs <= 20500
            && note.sizeBytes is int
            && note.sizeBytes > 0 && note.sizeBytes <= 262144
            && note.sha256 is string && note.sha256.size() == 64
            && exists(upload)
            && get(upload).data.uploaderUid == request.auth.uid
            && get(upload).data.targetUid == targetUid
            && get(upload).data.sha256 == note.sha256
          );
      }

      // The TARGET's delivery receipt: once, only `voiceNote.deliveredAt`,
      // never touching the approved metadata.
      function voiceDeliveryIsValid() {
        return !changedKeys().hasAny(['voiceNote'])
          || (
            resource.data.get('voiceNote', null) is map
            && !resource.data.voiceNote.keys().hasAny(['deliveredAt'])
            && request.resource.data.voiceNote is map
            && request.resource.data.voiceNote.diff(resource.data.voiceNote)
                 .affectedKeys().hasOnly(['deliveredAt'])
            && request.resource.data.voiceNote.deliveredAt is timestamp
          );
      }

      function outcomeIsValid() {
        return request.resource.data.outcome is map
          && (
            (request.resource.data.outcome.result == 'done'
              && request.resource.data.outcome.keys().hasOnly(
                   ['result', 'completedAt'])
              && request.resource.data.outcome.completedAt is timestamp)
            ||
            (request.resource.data.outcome.result == 'skipped'
              && request.resource.data.outcome.keys().hasOnly(
                   ['result', 'skippedAt', 'skipReason'])
              && request.resource.data.outcome.skippedAt is timestamp
              && (!('skipReason' in request.resource.data.outcome)
                  || request.resource.data.outcome.skipReason is string))
          );
      }

      function outcomeTransitionIsValid() {
        return !changedKeys().hasAny(['outcome'])
          || (
            request.resource.data.status == 'approved'
            && outcomeIsValid()
            && (
              // Human Done/Skip and the generic lapse are first-write-wins.
              resource.data.get('outcome', null) == null
              // The one permitted refinement: a native one-minute timeout is
              // more specific than the automatic end-of-day fallback.
              || (
                resource.data.outcome is map
                && resource.data.outcome.result == 'skipped'
                && resource.data.outcome.get('skipReason', '') == 'Did not respond'
                && request.resource.data.outcome.result == 'skipped'
                && request.resource.data.outcome.get('skipReason', '') == 'User unavailable'
              )
            )
          );
      }

      // The target always. A PLANNER holding access over them may also read so
      // Item 27 can derive day-scoped conflict TIMES from the live stream. It is
      // read-only: every write branch below still requires the caller to be the
      // target or the item's own creator, unchanged by this.
      //
      // Firestore cannot field-redact documents, so rules still authorize the
      // record read; the product boundary immediately projects it through
      // conflictInstantsForLocalDay and presentation receives no title/note.
      allow read: if signedIn()
        && (request.auth.uid == targetUid
            || callerIsFriendOf(targetUid));

      allow create: if signedIn()
        // The full key set a creator may write (note/decidedAt/tier optional).
        // `notified*` is absent, so an item cannot be born pre-silenced.
        && request.resource.data.keys().hasOnly([
             'targetUid', 'createdByUid', 'groupId', 'title', 'note',
             'localWallTime', 'timezone', 'scheduledInstantUtc', 'status',
             'tier', 'durationMinutes', 'planRequestId', 'decidedAt',
             'createdAt', 'updatedAt', 'voiceNote'
           ])
        && voiceNoteIsValidOnCreate()
        && request.resource.data.targetUid == targetUid
        && request.resource.data.createdByUid == request.auth.uid
        // No double-booking (Batch G item 4, strict): the item must arrive in
        // the same write as the lock on ITS minute, naming it. The lock rule
        // refuses a minute another live plan holds, so this is the server-side
        // clash check — and a client that skips the lock cannot create at all.
        && request.resource.data.scheduledInstantUtc is timestamp
        && getAfter(minuteLockPath(targetUid,
               request.resource.data.scheduledInstantUtc)).data.itemId == itemId
        // `tier` defaults to 'normal' when absent (old clients), and must be one
        // of the two. The default is what keeps a tierless create a NORMAL one.
        && request.resource.data.get('tier', 'normal') in ['normal', 'emergency']
        && (('durationMinutes' in request.resource.data)
            == ('planRequestId' in request.resource.data))
        && (!('durationMinutes' in request.resource.data)
            || (request.resource.data.durationMinutes is int
                && request.resource.data.durationMinutes >= 1
                && request.resource.data.durationMinutes <= 1440))
        && (!('planRequestId' in request.resource.data)
            || (
              // Reverse half of the atomic fulfillment link. The request must
              // have been open BEFORE this write, advance in this write, name
              // this exact item, and agree on parties/bounds/duration.
              exists(/databases/$(database)/documents/planRequests/$(request.resource.data.planRequestId))
              && get(/databases/$(database)/documents/planRequests/$(request.resource.data.planRequestId)).data.status
                   in ['pending', 'inProgress']
              && get(/databases/$(database)/documents/planRequests/$(request.resource.data.planRequestId)).data.requesterUid
                   == targetUid
              && get(/databases/$(database)/documents/planRequests/$(request.resource.data.planRequestId)).data.plannerUid
                   == request.auth.uid
              // Item 5b (2026-09-27): fulfilled through the normal Plan
              // screen, so it is an alarm like every other (`approved`);
              // `pending` is still accepted from older builds.
              && request.resource.data.status in ['pending', 'approved']
              && request.resource.data.get('tier', 'normal') == 'normal'
              && request.resource.data.groupId == ''
              && request.resource.data.durationMinutes is int
              && request.resource.data.scheduledInstantUtc
                   >= get(/databases/$(database)/documents/planRequests/$(request.resource.data.planRequestId)).data.windowStartUtc
              && request.resource.data.scheduledInstantUtc
                   + duration.value(request.resource.data.durationMinutes, 'm')
                   <= get(/databases/$(database)/documents/planRequests/$(request.resource.data.planRequestId)).data.windowEndUtc
              && getAfter(/databases/$(database)/documents/planRequests/$(request.resource.data.planRequestId)).data.lastFulfilledItemId
                   == itemId
            ))
        && (
          // Self-planning: consent is inherent. Any tier, pending or approved.
          (request.auth.uid == targetUid
              && request.resource.data.status in ['pending', 'approved'])
          // A PLANNER (F2, 2026-09-26 — the per-item approval step is gone;
          // Batch G items 2 + 3, 2026-09-27): someone may set alarms that ring
          // directly if they are the target's FRIEND (an untagged plan), or
          // both are members of the tagged GROUP (a group plan). No grant.
          // Re-checked live on every create, so unfriending, blocking, leaving
          // or removal ends it at once.
          //
          // `approved` is what new clients write. `pending` is still accepted
          // so an older installed build keeps working; the target's device
          // turns such items into alarms (LegacyPendingReconciler).
          || (request.resource.data.status in ['pending', 'approved']
              && request.resource.data.get('tier', 'normal') in ['normal', 'emergency']
              && ((request.resource.data.groupId == ''
                    && callerIsFriendOf(targetUid))
                  || callerMayGroupPlan(targetUid, request.resource.data.groupId)))
        );

      // Missed-alarm review is the sole settled-outcome correction. Keep this
      // separate from the generic target update predicate: every field and
      // both sides of the transition are exact, and the independent alarm fact
      // must already be present in the stored document.
      allow update: if signedIn()
        && request.auth.uid == targetUid
        && changedKeys().hasOnly(['outcome', 'updatedAt'])
        && resource.data.status == 'approved'
        && request.resource.data.status == 'approved'
        && resource.data.outcome is map
        && resource.data.outcome.get('result', '') == 'skipped'
        && resource.data.outcome.get('skipReason', '') == 'User unavailable'
        && resource.data.get('alarm', {}) is map
        && resource.data.get('alarm', {})
             .get('unavailableAt', null) is timestamp
        && request.resource.data.outcome is map
        && request.resource.data.outcome.keys().hasOnly(
             ['result', 'completedAt'])
        && request.resource.data.outcome.result == 'done'
        && request.resource.data.outcome.completedAt is timestamp;

      allow update: if signedIn()
        && (
          // Target: approve / reject / mark done / mark skipped, or append its
          // device-observed alarm timeline — and NOTHING else. `outcome` and
          // `alarm` are whole maps at the rules boundary even though the alarm
          // repository updates one nested timestamp at a time.
          (
            request.auth.uid == targetUid
            && changedKeys().hasOnly(
                 ['status', 'decidedAt', 'rejectionReason', 'outcome', 'alarm',
                  'voiceNote', 'updatedAt'])
            && alarmTimelineIsValid()
            && voiceDeliveryIsValid()
            && outcomeTransitionIsValid()
            && (!changedKeys().hasAny(['alarm'])
                || request.resource.data.status == 'approved')
            // Changing `status` is a DECISION, and a decision is only ever made
            // once, on a pending item: pending → approved | rejected. This stops
            // a target reviving a withdrawn/rejected item or faking a withdrawal.
            // markDone/markSkipped don't touch `status`, so they skip this test.
            && (
              !changedKeys().hasAny(['status'])
              || (resource.data.status == 'pending'
                  && request.resource.data.status in ['approved', 'rejected'])
            )
          )
          // Planner CANCEL (was "withdraw"): the creator flips an alarm they
          // set to `withdrawn`, touching only these three keys — a pending
          // (legacy) plan, or any approved alarm nobody has answered yet
          // (F2: every alarm now rings directly, so any can be cancelled
          // before it is done). Still cannot alter title/time/anything else.
          || (
            request.auth.uid == resource.data.createdByUid
            && (resource.data.status == 'pending'
                || (resource.data.status == 'approved'
                    && !('outcome' in resource.data)))
            && request.resource.data.status == 'withdrawn'
            && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['status', 'withdrawnAt', 'updatedAt'])
          )
        );

      allow delete: if false;
    }

    // ---- Collection-group READ rules ----
    // A `collectionGroup()` query is matched ONLY by a recursive `{path=**}`
    // rule — never by a rule scoped to a specific parent path (empirically
    // verified; see DECISIONS.md). These serve the planner's two cross-parent
    // queries. Both stay resource-scoped so a caller can read ONLY items they
    // created / grants that name them — the query MUST filter on the same field
    // (which the app's queries do) or Firestore denies it.
    // ---- plannerAccess/{plannerUid_targetUid} — RETIRED (item 3) ----
    // It was a groupId hint for reading a group member's schedule through a
    // group grant. Group grants are gone and group plans need no read, so the
    // row authorizes nothing and can no longer be written; the parties may
    // still read and delete leftovers.
    match /plannerAccess/{accessId} {
      allow get, list, delete: if signedIn()
        && (resource.data.plannerUid == request.auth.uid
            || resource.data.targetUid == request.auth.uid);
    }

    // ---- scheduleMinutes/{targetUid}/minutes/{epochMinute} ----
    // The double-booking lock (Batch G item 4, strict). One document per person
    // per minute, naming the live plan that holds it. Every item create must
    // arrive with its lock (item create rule), and:
    //   * a FREE minute may be claimed by whoever creates the plan in the same
    //     write, or by the target for one of their own live plans (the backfill
    //     of plans made before locks existed);
    //   * a HELD minute can be taken over ONLY when the plan holding it is no
    //     longer live (done, skipped, cancelled, rejected, lapsed or gone) — so
    //     there is no release step and no stale "busy";
    //   * a minute whose plan is live is refused: that is the clash.
    // Read by the target and their friends (the app's pre-check); a group
    // member who is not a friend learns "busy" only through the Worker, which
    // verifies it (groupPlanned).
    match /scheduleMinutes/{targetUid}/minutes/{minute} {
      function lockedPlan() {
        return /databases/$(database)/documents/scheduleItems/$(targetUid)/items/$(request.resource.data.itemId);
      }

      function claimIsValid() {
        let plan = getAfter(lockedPlan());
        return request.resource.data.keys().hasOnly(
                 ['targetUid', 'itemId', 'createdByUid', 'createdAt'])
          && request.resource.data.targetUid == targetUid
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.itemId is string
          && plan.data.targetUid == targetUid
          && epochMinute(plan.data.scheduledInstantUtc) == minute
          && plan.data.get('outcome', null) == null
          && plan.data.status in ['pending', 'approved']
          && (plan.data.createdByUid == request.auth.uid
              || request.auth.uid == targetUid);
      }

      allow get: if signedIn()
        && (request.auth.uid == targetUid || callerIsFriendOf(targetUid));
      allow list: if signedIn() && request.auth.uid == targetUid;

      allow create: if signedIn() && claimIsValid();

      allow update: if signedIn()
        && claimIsValid()
        && !planIsLive(/databases/$(database)/documents/scheduleItems/$(targetUid)/items/$(resource.data.itemId));

      allow delete: if false;
    }

    // ---- scheduleSlots/{targetUid}/slots/{slotIndex} ----
    // The 30-minute slot LOCK. Its only job is to make "B booked this slot while
    // A's modal was open" fail at write time instead of double-booking.
    //
    // There is no Cloud Function in this project and rules cannot run a query,
    // so overlap cannot be checked directly. What CAN be done is the pattern
    // `usernames/{handle}` and `joinCodes/{code}` already use: a computed id
    // whose `create` fails when the document exists. `update: if false` is what
    // makes it a lock — Firestore treats `set` on an existing doc as an update,
    // so the create branch only ever sees a genuinely free slot.
    //
    // Written in the same WriteBatch as the item, so the two land together or
    // not at all.
    //
    // Delete releases the slot when the item dies (withdraw / reject). Both the
    // target and the lock's own creator may do it; nobody else.
    match /scheduleSlots/{targetUid}/slots/{slotIndex} {
      allow read: if signedIn()
        && (request.auth.uid == targetUid
            || callerIsFriendOf(targetUid));

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['targetUid', 'createdByUid', 'groupId', 'itemId', 'createdAt'])
        && request.resource.data.targetUid == targetUid
        && request.resource.data.createdByUid == request.auth.uid
        // Exactly the people who may create the ITEM this lock guards, checked
        // the same way the item is: the target, a friend (untagged), or a
        // fellow member of the tagged group.
        && (request.auth.uid == targetUid
            || (request.resource.data.groupId == '' && callerIsFriendOf(targetUid))
            || callerMayGroupPlan(targetUid, request.resource.data.groupId));

      allow update: if false;

      allow delete: if signedIn()
        && (request.auth.uid == targetUid
            || resource.data.createdByUid == request.auth.uid);
    }

    match /{path=**}/items/{itemId} {
      allow read: if signedIn()
        && resource.data.createdByUid == request.auth.uid;
    }

    match /{path=**}/plannerGrants/{grantId} {
      allow read: if signedIn()
        && (resource.data.plannerUid == request.auth.uid
            || resource.data.targetUid == request.auth.uid);
    }

    // Everything else: deny. (No client path touches `invites/` — join is by
    // code on the group doc — so it stays closed until/unless that flow lands.)
  }
}
