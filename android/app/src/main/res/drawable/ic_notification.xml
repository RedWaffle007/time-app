<?xml version="1.0" encoding="utf-8"?>
<!--
    The FCM notification SMALL icon (UI-RULES.md §6.6; DECISIONS.md 2026-07-25).

    Android renders the small icon as an ALPHA-CHANNEL SILHOUETTE — every
    non-transparent pixel is repainted with the system tint. So this must be
    white-on-transparent line work and nothing else: any colour here is
    discarded, and a full-colour bitmap becomes a solid blob. That blob is
    exactly what shipped before this file existed, because the manifest declared
    no default_notification_icon and FCM fell back to @mipmap/ic_launcher.

    Kept deliberately simple — a clock ring and two hands. Detail does not
    survive silhouetting at 24dp.

    A vector rather than five PNG densities: one file, and crisp at any density.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Clock face. Two half-arcs rather than one 360° arc: an arc whose start
         and end points coincide is degenerate and renders inconsistently. -->
    <path
        android:pathData="M3.5,12 A8.5,8.5 0 1,1 20.5,12 A8.5,8.5 0 1,1 3.5,12 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2" />

    <!-- Hour and minute hands. -->
    <path
        android:pathData="M12,6.8 L12,12.4 L15.8,14.6"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
