<?xml version="1.0" encoding="utf-8"?>
<!--
    The FCM notification SMALL icon (UI-RULES.md §6.6; DECISIONS.md 2026-07-25).

    Android renders the small icon as an ALPHA-CHANNEL SILHOUETTE — every
    non-transparent pixel is repainted with the system tint. So this must be
    white-on-transparent line work and nothing else: any colour here is
    discarded, and a full-colour bitmap becomes a solid blob. That blob is
    exactly what shipped before this file existed, because the manifest declared
    no default_notification_icon and FCM fell back to @mipmap/ic_launcher.

    This is the Checkmate launcher mark reduced to its two defining shapes: the
    open C and the check. Android discards the launcher's green/orange colours,
    so both shapes are white and the system applies notification_accent.

    A vector rather than five PNG densities: one file, and crisp at any density.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The open C. Rounded ends preserve the launcher mark's two terminals. -->
    <path
        android:pathData="M18,5.2 C16.4,3.8 14.3,3 12,3 C7,3 3,7 3,12 C3,17 7,21 12,21 C14.3,21 16.4,20.2 18,18.8"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- The check, simplified for the 24dp notification tray. -->
    <path
        android:pathData="M6.3,12.2 L10.3,16.2 L17.7,7.7"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
