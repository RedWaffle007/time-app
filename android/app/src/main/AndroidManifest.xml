<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- REQUIRED IN RELEASE. Flutter only injects INTERNET into the debug/profile
         manifests (for the Dart VM service), so a release build that relies on
         those merges ships with NO network permission — Firebase/FCM/http then
         fail (SecurityException) and the app crashes on launch. Declare it here
         in the main manifest so release has it too. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ runtime notification permission, requested by the
         first-install reminders onboarding after its on-screen explanation. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Voice STT (redesign S6). The mic is requested at runtime by
         speech_to_text's initialize(), and ONLY after the on-screen rationale
         sheet — no raw prompt fires first, the same doctrine as the reminder
         permissions. Every voice path falls back to the identical manual flow
         if this is denied, so the app is fully usable without it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- ===================== THE REMINDER LAYER ===================== -->

    <!-- EXACT alarms, the user-granted route.

         SCHEDULE_EXACT_ALARM, deliberately NOT USE_EXACT_ALARM. Both reach the
         identical AlarmManager code path; the difference is who approves.
         USE_EXACT_ALARM is auto-granted but is Play-reviewed against a narrow
         list ("the app is an alarm or timer app" / "a calendar app that shows
         event notifications"), and we are neither. SCHEDULE_EXACT_ALARM is a
         user prompt with NO Play review, which is the whole reason the
         2026-08-19 policy re-check reopened this. See DECISIONS.md → "Exact
         alarms: the Play-policy assumption was wrong".

         From Android 14 this is DENIED by default and must be granted from
         Settings; `ReminderPermissions` sends the user there. On this Redmi it
         is also revoked by every reinstall (spike README trap 1). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <!-- AlarmManager keeps scheduled alarms in volatile memory ONLY — a reboot
         drops every one of them with no error to anyone. This permission is what
         lets both boot receivers below hear about the reboot and re-arm. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- A reminder must RING OVER whatever app is in the foreground, exactly like
         a clock alarm. An ordinary heads-up notification does not: HyperOS (and
         stock Android's own interruption heuristics) suppress a background app's
         alert — sound included — while another app holds the foreground, which is
         precisely why a reminder was silent while the user was in another app but
         loud when the screen was idle. A FULL-SCREEN INTENT is treated as a
         genuine alarm interruption instead of a suppressible notification, so it
         alerts unconditionally. On Android 14+ this permission is user-revocable
         for a non-alarm app; `canUseFullScreenIntent()` (native channel) reports
         the real state and the primer sends the user to grant it. Reminders are
         the core of this product, which is the use case this permission names. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>

    <!-- The alarm SOUND must survive the screen going dark. FLAG_INSISTENT on the
         notification loops the tone but holds nothing awake, so when the
         full-screen intent's screen times out the OS stops servicing it and the
         sound dies — the "rings a few seconds then cuts out" bug. Real alarm apps
         play the tone in a FOREGROUND SERVICE holding a PARTIAL_WAKE_LOCK; these
         three permissions are what that service needs. MEDIA_PLAYBACK is the FGS
         type Android 14+ requires and the conventional fit for alarm audio. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <!-- Battery / Doze exemption, requested as a DIRECT system dialog.

         Holding this permission is what lets the app fire
         `ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS` with a `package:` URI and
         get a one-tap yes/no dialog, instead of dumping the user into the whole
         battery-optimization LIST and asking them to hunt for us. It is the
         Doze-exemption analogue of SCHEDULE_EXACT_ALARM: reliable delivery is the
         whole product, and the OneKeyClean/Boost finding (CLAUDE.md checklist
         item 1) proved that a non-exempt process is killed with its alarms.

         DELIBERATE Play-policy declaration. Google restricts this permission to
         an acceptable-use list, and "the app schedules user-facing alarms /
         reminders and needs to run in the background to deliver them" is on it —
         we are a reminder/alarm app, which is exactly the qualifying case. This
         is on record for submission (DECISIONS.md → "Battery-exemption direct
         dialog — deliberate Play-policy declaration (2026-08-23)"). If review
         ever objects, the fallback is the non-declared
         ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS list intent, which needs no
         permission — a copy change in onboarding, not an architecture change. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <application
        android:label="Checkmate"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <!-- Default FCM notification channel for background/terminated
             `notification` messages. The Firebase SDK falls back to an
             auto-created default channel if this id doesn't exist yet. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="high_importance_channel" />
        <!-- Small icon + tint for tray notifications.

             WITHOUT the icon line, FCM falls back to @mipmap/ic_launcher — and
             because Android renders the small icon as an alpha silhouette, a
             full-colour launcher PNG shows up as a white blob. That was the
             behaviour of every tray notification this app has ever sent; the
             2026-07-24 delivery verification did not catch it because a
             FOREGROUND message is drawn by our own in-app banner and never
             touches the system small-icon path. See DECISIONS.md 2026-07-25. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ============ flutter_local_notifications' own receivers ============

             Since plugin v16 these are NOT declared by the plugin's manifest —
             the app must declare them, and a missing declaration fails silently:
             the alarm fires, the receiver is not found, and no notification ever
             appears. ScheduledNotificationReceiver posts the notification;
             ScheduledNotificationBootReceiver re-registers the plugin's own
             pending set after a reboot or an app update from its own store.

             MY_PACKAGE_REPLACED matters as much as BOOT_COMPLETED here: on this
             device a reinstall also revokes SCHEDULE_EXACT_ALARM (spike README
             trap 1), so an update silently downgrades every re-armed alarm. The
             Dart-side reconcile on next app start is the backstop for that. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- ==================== The fire-timing audit ====================

             Carried over from spikes/alarm_spike/. These two receivers post
             NOTHING and are invisible to the user; they exist so that "did the
             reminder actually fire, and how late" is answerable from real use
             rather than from a throwaway harness. A silent exact alarm is armed
             alongside every reminder at the same instant, and its receiver
             appends one CSV row recording the delay AND the device state (Doze,
             power save, battery-optimisation, screen) at the moment it landed —
             a 40-minute delay is uninterpretable without knowing whether the
             phone was in Doze when it arrived.

             directBootAware, and writing to device-protected storage, so the
             boot receiver can record a reboot on LOCKED_BOOT_COMPLETED — i.e.
             BEFORE the first unlock. Credential-protected storage throws there.

             It is a measurement instrument, not a feature. Deleting these two
             receivers, ReminderAudit*.kt and reminder_audit_log.dart removes it
             with no effect on whether reminders fire. -->
        <receiver
            android:exported="false"
            android:directBootAware="true"
            android:name=".reminders.ReminderAuditReceiver" />
        <!-- The due-time audio path. This receiver is a separate AlarmManager
             target from notification presentation, so an OEM may suppress the
             full-screen Activity without postponing sound until unlock. -->
        <receiver
            android:exported="false"
            android:directBootAware="true"
            android:name=".reminders.AlarmDeliveryReceiver" />
        <receiver
            android:exported="true"
            android:directBootAware="true"
            android:name=".reminders.AlarmDeliveryBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>
        <receiver
            android:exported="true"
            android:directBootAware="true"
            android:name=".reminders.ReminderAuditBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- Plays the alarm tone on a PARTIAL_WAKE_LOCK so it keeps ringing with
             the screen off, until dismissed (or the one-minute cap). Its silent,
             high-priority foreground notification carries a second full-screen
             launch path plus a native Dismiss action, so the alarm stays usable
             when Flutter's scheduled-notification presentation is suppressed.
             Not exported — AlarmDeliveryReceiver starts it at the due instant.
             The mediaPlayback FGS type matches AudioAttributes(USAGE_ALARM) and
             satisfies Android 14+'s typed-FGS requirement. -->
        <service
            android:name=".reminders.AlarmSoundService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- image_cropper's crop screen (UCrop). Required by the plugin; used
             for static profile photos only. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Voice STT (S6). From Android 11 package visibility is filtered, so
             speech_to_text cannot see the system recognition service unless we
             declare that we query for it. Without this, initialize() reports the
             device has no recognizer and every voice capture falls straight
             through to the manual flow. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
